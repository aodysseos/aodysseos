---
import BaseLayout from '../layouts/BaseLayout.astro';

const experience = [
  {
    title: 'Technical Lead',
    company: 'Bodyswaps',
    dates: 'Jan 2026 — Present',
    description:
      'Technical leadership for a VR and AI soft skills training platform: AI-powered immersive simulations that let people practise the conversations that matter.',
  },
  {
    title: 'Engineering Team Lead',
    company: 'Juro',
    dates: 'Mar 2024 — Jan 2026',
    description:
      'Led the Contracts Repository team, owning delivery of projects end-to-end across a MongoDB and Docker-based platform.',
  },
  {
    title: 'Senior Full-Stack Engineer',
    company: 'Juro',
    dates: 'Nov 2022 — Mar 2024',
    description:
      'Delivered integrations, observability and security improvements to the contract automation platform, working across React and Redis-backed services.',
  },
  {
    title: 'Software Engineer',
    company: 'Red Ant',
    dates: 'Oct 2018 — Nov 2022',
    description:
      'Built customer integrations and platform features for the RetailOS digital store platform, including a two-way messaging system on Twilio and AWS (Lambda, SQS, SES).',
  },
  {
    title: 'Software Developer',
    company: 'Univers Labs',
    dates: 'Nov 2015 — Oct 2018',
    description:
      'Designed and developed websites and web applications with React, React Native, D3.js, Node.js and WordPress.',
  },
];

const education = [
  {
    degree: 'MSc Web Technology',
    school: 'University of Southampton',
    dates: '2014 — 2015',
    grade: 'Distinction',
  },
  {
    degree: 'BSc Computer Science',
    school: 'The University of Sheffield',
    dates: '2011 — 2014',
    grade: 'Upper second-class honours (2:1)',
  },
];

const skills = [
  'JavaScript',
  'TypeScript',
  'React',
  'React Native',
  'Node.js',
  'MongoDB',
  'PostgreSQL',
  'Redis',
  'GraphQL',
  'AWS',
  'Docker',
  'Python',
  'Three.js',
  'D3.js',
  'Git',
];
---

<BaseLayout title="About" description="About Andreas Odysseos — Technical Lead and Software Engineer">
  <section class="about">
    <div class="about__hero">
      <h1>About</h1>
      <p class="about__intro">
        Technical Lead at Bodyswaps, building AI-powered immersive simulations for soft skills
        training at scale. Over ten years of experience delivering customer-facing web applications,
        from AI-driven platforms and real-time APIs to third-party integrations, with a focus on
        microservices architecture, platform security and observability. Works closely with product
        teams to take features from idea to production. Based in the UK.
      </p>
    </div>

    <section class="about__section">
      <h2>Experience</h2>
      <div class="timeline">
        {experience.map((role) => (
          <div class="timeline__item">
            <div class="timeline__marker"></div>
            <div class="timeline__content">
              <h3>{role.title}</h3>
              <p class="timeline__company">{role.company}</p>
              <p class="timeline__date">{role.dates}</p>
              <p class="timeline__desc">{role.description}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="about__section">
      <h2>Education</h2>
      <div class="timeline">
        {education.map((entry) => (
          <div class="timeline__item">
            <div class="timeline__marker"></div>
            <div class="timeline__content">
              <h3>{entry.degree}</h3>
              <p class="timeline__company">{entry.school}</p>
              <p class="timeline__date">{entry.dates}</p>
              <p class="timeline__desc">{entry.grade}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="about__section">
      <h2>Certifications</h2>
      <div class="timeline">
        <div class="timeline__item">
          <div class="timeline__marker"></div>
          <div class="timeline__content">
            <h3>MongoDB Node.js Developer Path</h3>
            <p class="timeline__company">MongoDB</p>
            <p class="timeline__date">2024</p>
          </div>
        </div>
      </div>
    </section>

    <section class="about__section">
      <h2>Technologies</h2>
      <div class="skills">
        {skills.map((skill) => (
          <span class="skills__tag">{skill}</span>
        ))}
      </div>
    </section>
  </section>
</BaseLayout>

<style>
  .about {
    padding: 5rem 0 4rem;
  }

  .about__hero {
    margin-bottom: 4rem;
  }

  .about__hero h1 {
    font-size: 2.25rem;
    margin-bottom: 1.5rem;
  }

  .about__intro {
    font-size: 1.125rem;
    font-weight: 300;
    line-height: 1.7;
    color: var(--color-secondary);
    max-width: 600px;
  }

  .about__section {
    margin-bottom: 3.5rem;
  }

  .about__section h2 {
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 2rem;
    color: var(--color-secondary);
  }

  .timeline {
    border-left: 1px solid var(--color-border);
    padding-left: 2rem;
  }

  .timeline__item {
    position: relative;
    margin-bottom: 2.5rem;
  }

  .timeline__marker {
    position: absolute;
    left: calc(-2rem - 4px);
    top: 6px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--color-primary);
  }

  .timeline__content h3 {
    font-size: 1.125rem;
    font-weight: 800;
    margin-bottom: 0.25rem;
  }

  .timeline__company {
    font-weight: 400;
    color: var(--color-primary);
    margin-bottom: 0.25rem;
  }

  .timeline__date {
    font-size: 0.85rem;
    color: var(--color-secondary);
    margin-bottom: 0.5rem;
  }

  .timeline__desc {
    font-weight: 300;
    line-height: 1.6;
    color: var(--color-secondary);
  }

  .skills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .skills__tag {
    font-size: 0.85rem;
    font-weight: 400;
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--color-border);
    border-radius: 2px;
    color: var(--color-primary);
    transition: background-color var(--transition-fast), border-color var(--transition-fast);
  }

  .skills__tag:hover {
    background-color: var(--color-primary);
    color: var(--color-background);
    border-color: var(--color-primary);
  }
</style>
