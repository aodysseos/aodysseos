---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const {
  title,
  subtitle,
  date,
  tags,
  colorBackground,
  colorPrimary,
  colorSecondary,
  bannerIcons,
  heroImage,
} = article.data;
---

<BaseLayout title={title} description={subtitle || title}>
  <article class="article">
    <!-- Hero -->
    <div class="hero" style={`background-color: ${colorBackground}`}>
      {bannerIcons.length > 0 ? (
        <div class="hero__icons">
          {bannerIcons.map((icon) => (
            <img src={icon} alt="" class="hero__icon" />
          ))}
        </div>
      ) : (
        heroImage && <img src={heroImage} alt="" class="hero__image" />
      )}
    </div>

    <!-- Title card overlapping hero -->
    <div class="title-card">
      <h1>{title}</h1>
      {subtitle && <h2>{subtitle}</h2>}
      {tags.length > 0 && (
        <div class="meta">
          {tags.map((tag, i) => (
            <>
              <a href={`/writing`} class="meta__tag">
                <span>{tag}</span>
              </a>
              {i < tags.length - 1 && <span class="meta__sep">, </span>}
            </>
          ))}
        </div>
      )}
    </div>

    <!-- Content -->
    <div
      class="content"
      style={`--article-color: ${colorPrimary}; --article-bg: ${colorBackground}; --gradient: linear-gradient(90deg, ${colorBackground} 0%, ${colorSecondary} 35%, ${colorPrimary} 100%);`}
    >
      <Content />
    </div>

    <footer class="article-footer">
      <a href="/writing">&larr; All writing</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .article {
    padding-bottom: 4rem;
  }

  /* Hero - matches original */
  .hero {
    min-height: 100px;
    height: 393px;
    overflow: hidden;
    width: 100%;
  }

  @media (min-width: 1200px) {
    .hero {
      width: 83%;
      margin: 0 0 0 auto;
    }
  }

  .hero__icons {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: row;
    justify-content: space-evenly;
    align-items: center;
  }

  .hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 35%;
  }

  .hero__icon {
    width: auto;
    max-width: 25%;
    height: 100px;
    max-height: 100px;
    object-fit: contain;
  }

  /* Title card - matches original overlap style */
  .title-card {
    /* above the hero image where the two overlap */
    position: relative;
    width: 100%;
    min-height: 192px;
    padding: 2rem;
    margin: 0;
    background-color: var(--color-background);
  }

  @media (min-width: 768px) {
    .title-card {
      width: 84%;
      margin: -64px auto 3rem 8%;
    }
  }

  @media (min-width: 1200px) {
    .title-card {
      width: 58%;
      margin: -64px auto 0 8%;
    }
  }

  .title-card h1 {
    font-size: clamp(30px, 4vw, 34px);
    line-height: 1.17;
    font-weight: 800;
    margin-bottom: 0.5rem;
    color: var(--color-primary);
  }

  .title-card h2 {
    font-size: clamp(30px, 4vw, 34px);
    line-height: 1.17;
    font-weight: 300;
    color: var(--color-secondary);
    letter-spacing: -0.8px;
  }

  /* Meta tags */
  .meta {
    margin-top: 32px;
  }

  .meta__tag {
    font-size: 0.875rem;
    line-height: 1.1;
    font-weight: 400;
    letter-spacing: -0.8px;
    color: var(--color-tertiary);
    text-decoration: none;
  }

  .meta__tag span {
    position: relative;
  }

  .meta__tag span::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    height: 1px;
    width: 100%;
    background-color: var(--color-tertiary);
    transform: scaleX(0);
    transform-origin: bottom left;
    transition: transform 0.3s ease-out;
    will-change: transform;
  }

  .meta__tag:hover span::after {
    transform: scaleX(1);
  }

  .meta__sep {
    color: var(--color-tertiary);
  }

  /* Content - matches original asymmetric layout */
  .content {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    margin: 0 2rem;
  }

  @media (min-width: 768px) {
    .content {
      margin: 0 3rem;
    }
  }

  .content :global(p),
  .content :global(h3),
  .content :global(h4),
  .content :global(h5),
  .content :global(h6),
  .content :global(ul),
  .content :global(ol),
  .content :global(blockquote) {
    display: block;
    width: 100%;
    margin: 0 auto 2.25rem 0;
  }

  @media (min-width: 768px) {
    .content :global(p),
    .content :global(h3),
    .content :global(h4),
    .content :global(h5),
    .content :global(h6),
    .content :global(ul),
    .content :global(ol),
    .content :global(blockquote) {
      width: 84%;
      margin: 0 8% 2.25rem auto;
    }
  }

  @media (min-width: 1200px) {
    .content :global(p),
    .content :global(h3),
    .content :global(h4),
    .content :global(h5),
    .content :global(h6),
    .content :global(ul),
    .content :global(ol),
    .content :global(blockquote) {
      width: 55%;
      margin: 0 8% 2.25rem auto;
    }
  }

  .content :global(p) {
    font-weight: 300;
    line-height: 1.8;
    color: var(--color-tertiary);
  }

  .content :global(h3) {
    font-size: 1.375rem;
    font-weight: 800;
    margin-top: 1rem;
  }

  .content :global(h5) {
    font-size: 19px;
    line-height: 1.17;
    font-weight: 600;
  }

  .content :global(ul),
  .content :global(ol) {
    padding-left: 19px;
    list-style: disc;
  }

  .content :global(ol) {
    list-style: decimal;
  }

  .content :global(li) {
    margin-bottom: 0.725rem;
    font-weight: 300;
    color: var(--color-tertiary);
  }

  .content :global(a) {
    color: var(--color-primary);
    text-decoration: none;
    position: relative;
  }

  .content :global(a)::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 1px;
    background-color: var(--article-color);
    transform: scaleX(0);
    transform-origin: bottom left;
    transition: transform 0.3s ease-out;
  }

  .content :global(a:hover)::after {
    transform: scaleX(1);
  }

  .content :global(blockquote) {
    border-left: 2px solid var(--article-color);
    padding-left: 25px;
    font-style: italic;
  }

  .content :global(.article-image) {
    width: 100%;
    height: auto;
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    padding: 1.45rem;
    margin-bottom: 3.45rem;
    background: var(--gradient);
  }

  .content :global(.article-image img) {
    width: initial;
    box-shadow: 0 2px 30px -15px rgba(0, 0, 0, 0.8);
  }

  .content :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background-color: var(--color-surface);
    padding: 0.15em 0.35em;
    border-radius: 3px;
  }

  .content :global(pre) {
    width: 100%;
    background-color: var(--color-surface);
    padding: 1.25rem;
    border-radius: 3px;
    overflow-x: auto;
    margin-bottom: 2.25rem;
    font-size: 0.85rem;
    line-height: 1.5;
  }

  @media (min-width: 768px) {
    .content :global(pre) {
      width: 84%;
      margin: 0 8% 2.25rem auto;
    }
  }

  @media (min-width: 1200px) {
    .content :global(pre) {
      width: 55%;
      margin: 0 8% 2.25rem auto;
    }
  }

  .content :global(pre code) {
    background: none;
    padding: 0;
  }

  /* Footer */
  .article-footer {
    margin: 4rem 2rem 0;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  @media (min-width: 768px) {
    .article-footer {
      margin: 4rem 3rem 0;
      width: 84%;
      margin-left: auto;
      margin-right: 8%;
    }
  }

  @media (min-width: 1200px) {
    .article-footer {
      width: 55%;
      margin-left: auto;
      margin-right: 8%;
    }
  }

  .article-footer a {
    font-size: 0.9rem;
    color: var(--color-secondary);
    transition: color var(--transition-fast);
  }

  .article-footer a:hover {
    color: var(--color-primary);
  }
</style>
