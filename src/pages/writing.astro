---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import linkedinPosts from '../content/linkedin/posts.json';

const articles = (await getCollection('articles'))
  .filter((a) => !a.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Writing" description="Articles and posts by Andreas Odysseos">
  <section class="writing">
    <div class="banner">
      <h1 class="banner__title">Articles</h1>
      <h2 class="banner__subtitle">Explore</h2>
    </div>

    <div class="articles-grid">
      {articles.map((article, index) => (
        <article class:list={['card', { 'card--featured': index === 0 }]}>
          <a href={`/writing/${article.id}`} class="card__image-link">
            {article.data.bannerIcons.length > 0 ? (
              <div
                class="card__icons"
                style={`background-color: ${article.data.colorBackground}`}
              >
                {article.data.bannerIcons.map((icon) => (
                  <img src={icon} alt="" class="card__icon" />
                ))}
              </div>
            ) : article.data.heroImage ? (
              <div
                class="card__thumbnail"
                style={`background-image: url('${article.data.heroImage}')`}
              />
            ) : (
              <div
                class="card__icons"
                style={`background-color: ${article.data.colorBackground}`}
              />
            )}
          </a>
          <div class="card__title">
            <a href={`/writing/${article.id}`} class="card__title-link">
              <h3>{article.data.title}</h3>
              {article.data.subtitle && <h4>{article.data.subtitle}</h4>}
            </a>
          </div>
        </article>
      ))}
    </div>

    {linkedinPosts.length > 0 && linkedinPosts[0].title !== 'Example LinkedIn Post' && (
      <div class="linkedin-section">
        <div class="banner" style="margin-top: 4rem;">
          <h2 class="banner__subtitle">LinkedIn</h2>
        </div>
        <div class="linkedin-feed">
          {linkedinPosts.map((post) => (
            <a href={post.url} target="_blank" rel="noopener noreferrer" class="linkedin-card">
              <div class="linkedin-card__meta">
                <time datetime={post.date}>
                  {new Date(post.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
                </time>
                <span class="linkedin-card__badge">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" style="vertical-align: -2px; margin-right: 4px;">
                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                  </svg>
                  LinkedIn
                </span>
              </div>
              <h3 class="linkedin-card__title">{post.title}</h3>
              <p class="linkedin-card__excerpt">{post.excerpt}</p>
            </a>
          ))}
        </div>
      </div>
    )}
  </section>
</BaseLayout>

<style>
  .writing {
    padding-bottom: 4rem;
  }

  /* Banner - matches original */
  .banner {
    margin-top: 76px;
  }

  .banner__title {
    font-size: clamp(30px, 4vw, 34px);
    line-height: 1.17;
    font-weight: 800;
    color: var(--color-primary);
    margin-bottom: 0.5rem;
  }

  .banner__subtitle {
    font-size: clamp(30px, 4vw, 34px);
    line-height: 1.17;
    font-weight: 300;
    color: var(--color-secondary);
    letter-spacing: -0.8px;
  }

  /* Articles grid - matches original flex layout */
  .articles-grid {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: stretch;
    margin-top: 64px;
  }

  .card {
    display: flex;
    flex-direction: column;
    flex: 0 0 100%;
    margin-bottom: 3rem;
  }

  @media (min-width: 768px) {
    .card {
      flex: 0 0 50%;
    }

    .card:nth-child(odd) {
      padding-left: 12px;
    }

    .card:nth-child(even) {
      padding-right: 12px;
    }

    .card--featured {
      flex: 0 0 100%;
      padding-left: 0;
      padding-right: 0;
    }
  }

  .card__image-link {
    display: block;
  }

  .card__icons {
    width: 100%;
    height: 400px;
    display: flex;
    flex-direction: row;
    justify-content: space-evenly;
    align-items: center;
    overflow: hidden;
    padding: 2rem;
  }

  .card__icon {
    width: auto;
    max-width: 30%;
    height: 100px;
    max-height: 100px;
    object-fit: contain;
  }

  .card__thumbnail {
    width: 100%;
    height: 400px;
    background-repeat: no-repeat;
    background-position: center center;
    background-size: cover;
  }

  /* Card title - matches original */
  .card__title {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    flex: 1;
    margin: 32px 0;
  }

  .card--featured .card__title {
    width: 100%;
    min-height: 192px;
    padding: 2rem 0;
    margin: 0;
    background-color: var(--color-background);
  }

  @media (min-width: 768px) {
    .card--featured .card__title {
      width: 84%;
      padding: 2rem;
      margin: -64px auto 2rem 2%;
    }
  }

  @media (min-width: 1200px) {
    .card--featured .card__title {
      width: 48%;
      padding: 2rem;
      margin: -64px auto 2rem 2%;
    }
  }

  .card__title-link {
    text-decoration: none;
  }

  .card__title-link h3 {
    font-size: 34px;
    font-weight: 800;
    display: inline;
    color: var(--color-primary);
    padding-right: 5px;
  }

  .card__title-link h4 {
    font-size: 34px;
    font-weight: 300;
    display: inline;
    color: var(--color-secondary);
    letter-spacing: -0.8px;
  }

  /* LinkedIn section */
  .linkedin-feed {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .linkedin-card {
    display: block;
    padding: 1.75rem;
    border: 1px solid var(--color-border);
    border-radius: 2px;
    transition: border-color var(--transition-fast);
  }

  .linkedin-card:hover {
    border-color: var(--color-primary);
  }

  .linkedin-card__meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .linkedin-card__meta time {
    font-size: 0.8rem;
    color: var(--color-secondary);
  }

  .linkedin-card__badge {
    font-size: 0.7rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #0a66c2;
  }

  .linkedin-card__title {
    font-size: 1.125rem;
    font-weight: 800;
    margin-bottom: 0.5rem;
  }

  .linkedin-card__excerpt {
    font-weight: 300;
    color: var(--color-secondary);
    line-height: 1.6;
    margin: 0;
  }
</style>
